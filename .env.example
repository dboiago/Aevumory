# Aevumory server configuration — copy these values into your environment.
# The server reads environment variables directly; it does not load a
# .env file automatically. Export them in your shell (or set them in your
# service / container configuration) before running `npm start`.
#
#   export PORT=3000
#   export DATA_DIR=./data

# Port the single server process listens on (serves /api/* and the
# built frontend on the same port). Default: 3000
PORT=3000

# Directory holding the SQLite database (aevumory.db). Created on start
# if it does not exist. May be absolute, or relative to the project root.
# Point this at persistent storage (e.g. a mounted volume) so household
# state survives restarts. Default: ./data
DATA_DIR=./data
